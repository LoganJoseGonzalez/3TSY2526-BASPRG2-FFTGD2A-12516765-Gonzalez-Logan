#include <iostream>
#include <string>
#include <cstdlib>
#include <ctime>
#include "Node.h"

using namespace std;

Node* plusGrunt(Node* tail, string name);
void printList(Node* start, int total);
Node* killGrunt(Node*& curr, int total);

int main() {
    srand((unsigned int)time(NULL));

    Node* tail = nullptr;
    int total = 0;
    string input = "";

    while (total < 5) {
        cout << "Name 5 Grunts\n";
        cout << "Name? ";
        getline(cin, input);
        if (input != "") {
            tail = plusGrunt(tail, input);
            total++;
            system("pause");
            system("cls");
        }
    }

    Node* counter = tail->next;
    int steps = rand() % total;
    for (int i = 0; i < steps; i++) {
        counter = counter->next;
    }
    cout << endl;

    int roundCounter = 1;
    while (total > 0) {
        switch (total) {
        case 1:
            cout << "Result\n";
            cout << counter->name << " finds more grunts\n\n";

            delete counter; 
            total--;
            break;

        default:
            cout << "Round " << roundCounter << "\n";

            printList(counter, total);
            counter = killGrunt(counter, total); 

            total--;
            roundCounter++;
            system("pause");
            system("cls");
            break;
        }
    }

    cout << "Press any key to continue";
    cin.get();
    return 0;
}

Node* plusGrunt(Node* tail, string name) {
    Node* alt = new Node();
    alt->name = name;

    if (tail == nullptr) {
        alt->next = alt;
        alt->previous = alt;
        return alt;
    }

    Node* head = tail->next;
    alt->next = head;
    alt->previous = tail;
    tail->next = alt;
    head->previous = alt;
    return alt;
}

void printList(Node* start, int total) {
    cout << "Grunts Left:\n";
    Node* alt = start;
    for (int i = 0; i < total; i++) {
        cout << alt->name << "\n";
        alt = alt->next;
    }
    cout << "\n";
}

Node* killGrunt(Node*& counter, int total) {
    int roll = (rand() % total) + 1;
    cout << counter->name << " rolled " << roll << "\n";

    Node* target = counter;
    for (int i = 0; i < roll; i++) {
        target = target->next;
    }
    cout << target->name << " Died\n\n";

    Node* nextGrunt = target->next;
    Node* leftGrunt = target->previous;
    Node* rightGrunt = target->next;

    leftGrunt->next = rightGrunt;
    rightGrunt->previous = leftGrunt;

    delete target;
    return nextGrunt;
}
